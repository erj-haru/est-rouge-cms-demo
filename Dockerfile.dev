# syntax=docker/dockerfile:1
# Astro 開発サーバー用イメージ（ローカルプレビュー専用。本番ビルドには使用しない）
# Node.js は Astro 7.4 の要件（>=22.22.0）を満たす LTS を固定する
ARG NODE_VERSION=22.23.4
FROM node:${NODE_VERSION}-bookworm-slim

ENV NODE_ENV=development \
    ASTRO_TELEMETRY_DISABLED=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false

WORKDIR /app

# 公式イメージに含まれる非 root ユーザー node で実行する。
# node_modules / .astro はボリュームのマウント先になるため、先に node 所有で作成しておく
RUN mkdir -p /app/node_modules /app/.astro && chown -R node:node /app
USER node

# 依存関係はロックファイルのみから再現可能にインストールする（ソースは compose でバインドマウント）。
# エントリーポイントと同じ処理で npm ci とインストール済みの印（.install-stamp）の書き込みを行い、
# 初回起動時に再インストールが走らないようにする
COPY --chown=node:node docker/dev-entrypoint.sh /usr/local/bin/dev-entrypoint.sh
COPY --chown=node:node package.json package-lock.json ./
RUN sh /usr/local/bin/dev-entrypoint.sh true

EXPOSE 4321
# コンテナ内では開発サーバーは常に 1 つだけなので、Astro のロックファイルは使わない
# （停止時に残ったロックファイルで再起動が失敗するのを防ぐ）
ENTRYPOINT ["sh", "/usr/local/bin/dev-entrypoint.sh"]
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "4321", "--ignore-lock"]
