---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NewsCard from '../../../components/NewsCard.astro';
import { locales, type Locale } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/ui';
import { getNewsByLocale, newsListUrl } from '../../../lib/news';

export const getStaticPaths = (() => locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const entries = await getNewsByLocale(lang);
const alternates = Object.fromEntries(locales.map((l) => [l, newsListUrl(l)])) as Record<Locale, string>;
---

<BaseLayout lang={lang} title={t('news.title')} description={t('news.lead')} alternates={alternates}>
  <div class="container">
    <header class="page-header">
      <h1>{t('news.title')}</h1>
      <p>{t('news.lead')}</p>
    </header>

    {
      entries.length > 0 ? (
        <ul class="list">
          {entries.map((entry, i) => (
            <li>
              <NewsCard entry={entry} lang={lang} eager={i < 3} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">{t('news.empty')}</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .container {
    max-width: calc(var(--content-width) + var(--gutter) * 2);
    margin: 0 auto;
    padding: var(--space-xl) var(--gutter) 0;
  }

  .page-header {
    margin-bottom: var(--space-xl);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 7vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.06em;
  }

  .page-header p {
    margin: var(--space-s) 0 0;
    color: var(--color-muted);
  }

  .list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--space-xl) var(--space-l);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .empty {
    color: var(--color-muted);
  }
</style>
